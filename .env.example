# Base URL of the 22studio-payroll-system public API — covers both the
# order-tracking endpoints (public_api.md) and the CMS content endpoint
# (public_api_cms.md), which share the same host/base path.
# Falls back to the deployed default in src/services/apiConfig.js if unset.
VITE_API_BASE_URL=https://22studio-payroll-system.vercel.app/api/public
